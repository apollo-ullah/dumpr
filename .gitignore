# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.local.example

# brainstorm + worktree directories (skill workspaces)
.superpowers/
.worktrees/

# internal design specs and implementation plans (workflow artifacts, kept local only)
docs/superpowers/

# scratch screenshot directory (workflow tool dumps PNGs here)
/screenshots/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
